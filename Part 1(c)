#MIPS Program IsFibonacciOdd(n)

.data
n:        .word 5
result:   .word 0

.text
main:
    #Step 1: Compute Fibonacci(n)
    la $t0, n           
    lw $t1, 0($t0)     
    ble $t1, 1, fib_done 
    
    li $t2, 0           
    li $t3, 1           
    li $t4, 0           
    addi $t6, $t1, -1   

fib_loop:
    bge $t4, $t6, fib_end 
    move $t7, $t3       
    add $t3, $t2, $t3   
    move $t2, $t7       
    addi $t4, $t4, 1    
    j fib_loop

fib_end:
    move $t1, $t3      

fib_done:

    #Step 2: Check if Odd using Division by Repeated Subtraction
    li $t2, 2          
div_loop:
    blt $t1, $t2, check_remainder 
    sub $t1, $t1, $t2   
    j div_loop

check_remainder:
    beq $t1, $zero, even 
    
odd:
    li $t3, 1          
    j store_result

even:
    li $t3, 0           

store_result:
    la $t4, result      
    sw $t3, 0($t4)     
    li $v0, 10         
    syscall
